v {xschem version=3.4.4 file_version=1.2
* Sec. 6.3: decodificador 2 a 4 para elegir el canal
}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
V {}
S {}
E {}
L 4 -100 -60 100 -60 {}
L 4 100 -60 100 60 {}
L 4 100 60 -100 60 {}
L 4 -100 60 -100 -60 {}
L 4 -120 -10 -100 -10 {}
B 5 -122.5 -12.5 -117.5 -7.5 {name=s0 dir=in}
T {s0} -96 -21 0 0 0.17 0.17 {}
L 4 -120 10 -100 10 {}
B 5 -122.5 7.5 -117.5 12.5 {name=s1 dir=in}
T {s1} -96 -1 0 0 0.17 0.17 {}
L 4 100 -30 120 -30 {}
B 5 117.5 -32.5 122.5 -27.5 {name=sel0 dir=out}
T {sel0} 96 -41 0 1 0.17 0.17 {}
L 4 100 -10 120 -10 {}
B 5 117.5 -12.5 122.5 -7.5 {name=sel1 dir=out}
T {sel1} 96 -21 0 1 0.17 0.17 {}
L 4 100 10 120 10 {}
B 5 117.5 7.5 122.5 12.5 {name=sel2 dir=out}
T {sel2} 96 -1 0 1 0.17 0.17 {}
L 4 100 30 120 30 {}
B 5 117.5 27.5 122.5 32.5 {name=sel3 dir=out}
T {sel3} 96 19 0 1 0.17 0.17 {}
L 4 0 -80 0 -60 {}
L 4 0 60 0 80 {}
B 5 -2.5 -82.5 2.5 -77.5 {name=vdd dir=inout}
B 5 -2.5 77.5 2.5 82.5 {name=gnd dir=inout}
T {vdd} 6 -57 0 0 0.17 0.17 {}
T {gnd} 6 47 0 0 0.17 0.17 {}
T {@symname} 0 -44 0 0 0.2 0.2 {hcenter=true}
T {@name} 6 -80 0 0 0.2 0.2 {}
L 4 -30 -22 30 -22 {}
L 4 30 -22 30 28 {}
L 4 30 28 -30 28 {}
L 4 -30 28 -30 -22 {}
T {DEC} 0 -18 0 0 0.2 0.2 {hcenter=true}
T {2:4} 0 4 0 0 0.2 0.2 {hcenter=true}

v {xschem version=3.4.4 file_version=1.2
* Switch de VDD: EN=1 conecta VDD a VVDD (Msw 40/0.13), EN=0 descarga VVDD (MNpd)
}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
V {}
S {}
E {}
L 4 -100 -60 100 -60 {}
L 4 100 -60 100 60 {}
L 4 100 60 -100 60 {}
L 4 -100 60 -100 -60 {}
L 4 -120 0 -100 0 {}
B 5 -122.5 -2.5 -117.5 2.5 {name=en dir=in}
T {en} -96 -11 0 0 0.17 0.17 {}
L 4 100 0 120 0 {}
B 5 117.5 -2.5 122.5 2.5 {name=vvdd dir=out}
T {vvdd} 96 -11 0 1 0.17 0.17 {}
L 4 0 -80 0 -60 {}
B 5 -2.5 -82.5 2.5 -77.5 {name=vdd dir=inout}
T {vdd} 6 -57 0 0 0.17 0.17 {}
L 4 0 60 0 80 {}
B 5 -2.5 77.5 2.5 82.5 {name=gnd dir=inout}
T {gnd} 6 47 0 0 0.17 0.17 {}
T {@symname} 0 -44 0 0 0.2 0.2 {hcenter=true}
T {@name} 6 -82 0 0 0.2 0.2 {}
T {VDD -> VVDD} 0 26 0 0 0.17 0.17 {hcenter=true layer=8}

# shellcheck shell=bash
# =============================================================================
#  SOURCEME — Selecciona el PDK IHP SG13G2 fijado en este repositorio.
#
#  Uso (dentro del contenedor, desde la raíz del repo):
#      source ./SOURCEME
#
#  Exporta PDK_ROOT=<repo>/pdk/ihp-sg13g2 y PDK=ihp-sg13g2, reemplazando el
#  PDK que trae el contenedor (/foss/pdks). Arma KLAYOUT_PATH y
#  SPICE_USERINIT_DIR para que KLayout, Xschem y ngspice usen SOLO el PDK
#  fijado. No descarga nada ni modifica archivos.
# =============================================================================

_sourceme_main() {
  local is_direct=0
  local src=""
  if [ -n "${BASH_VERSION:-}" ]; then
    src="${BASH_SOURCE[0]}"
    [ "$src" = "$0" ] && is_direct=1
  elif [ -n "${ZSH_VERSION:-}" ]; then
    # shellcheck disable=SC2296
    src="${(%):-%x}"
    case "${ZSH_EVAL_CONTEXT:-}" in
      *:file*) ;;
      *) is_direct=1 ;;
    esac
  else
    echo "[ERROR] SOURCEME solo soporta Bash o Zsh." >&2
    return 1 2>/dev/null || exit 1
  fi

  if [ "$is_direct" -eq 1 ]; then
    echo "[ERROR] SOURCEME se debe cargar con: source ${src:-./SOURCEME}" >&2
    exit 1
  fi

  local root_dir
  root_dir="$(cd -P -- "$(dirname -- "$src")" >/dev/null 2>&1 && pwd)" || root_dir=""
  if [ -z "$root_dir" ] || [ ! -d "$root_dir" ]; then
    echo "[ERROR] No pude determinar la raíz del repositorio." >&2
    return 1
  fi

  local pdk_root="${root_dir}/pdk/ihp-sg13g2"
  local pdk_name="ihp-sg13g2"
  local pdk_path="${pdk_root}/${pdk_name}"
  local klayout_parent="${pdk_path}/libs.tech/klayout"
  local tech_dir="${klayout_parent}/tech"
  local local_klayout="${root_dir}/.pdk_local/klayout"

  if [ ! -f "${tech_dir}/sg13g2.lyt" ] || [ ! -f "${pdk_path}/libs.tech/xschem/xschemrc" ] \
     || [ ! -f "${pdk_path}/libs.tech/ngspice/.spiceinit" ]; then
    echo "[ERROR] El PDK fijado no está descargado o está incompleto." >&2
    echo "        Desde PowerShell, en la carpeta del repo, ejecutá:" >&2
    echo "          git submodule update --init --recursive" >&2
    return 1
  fi

  # --- KLAYOUT_PATH -----------------------------------------------------------
  # Orden: config personal de KLayout, librerías locales (stdcells), PDK fijado.
  # Se DESCARTAN las entradas previas que apunten a otro PDK (p.ej. /foss/pdks),
  # para que KLayout no cargue dos versiones de PCells/DRC/LVS a la vez.
  local new_klayout_path=""
  _sourceme_add_path() {
    [ -z "$1" ] && return 0
    case ":${new_klayout_path}:" in
      *:"$1":*) ;;
      *) new_klayout_path="${new_klayout_path:+${new_klayout_path}:}$1" ;;
    esac
  }
  _sourceme_add_path "${KLAYOUT_HOME:-/headless/.klayout}"
  [ -d "$local_klayout" ] && _sourceme_add_path "$local_klayout"
  _sourceme_add_path "$klayout_parent"
  _sourceme_add_path "$tech_dir"

  local rem="${KLAYOUT_PATH:-}" part
  while [ -n "$rem" ]; do
    part="${rem%%:*}"
    case "$part" in
      */libs.tech/klayout|*/libs.tech/klayout/*) ;;   # otro PDK: se descarta
      *) _sourceme_add_path "$part" ;;
    esac
    if [ "$rem" = "$part" ]; then rem=""; else rem="${rem#*:}"; fi
  done
  unset -f _sourceme_add_path

  export PDK_ROOT="$pdk_root"
  export PDK="$pdk_name"
  export PDKPATH="$pdk_path"
  export STD_CELL_LIBRARY="sg13g2_stdcell"
  export SPICE_USERINIT_DIR="${pdk_path}/libs.tech/ngspice"
  export KLAYOUT_PATH="$new_klayout_path"
  export ASIC_UCC_ROOT="$root_dir"

  # --- Verificaciones rápidas (solo avisos) -------------------------------------
  local pinned="" current="" short="desconocido"
  if command -v git >/dev/null 2>&1; then
    pinned="$(git -c safe.directory='*' -C "$root_dir" ls-tree HEAD pdk/ihp-sg13g2 2>/dev/null | awk '{print $3}')"
    current="$(git -c safe.directory='*' -C "$pdk_root" rev-parse HEAD 2>/dev/null)"
    [ -n "$current" ] && short="${current:0:8}"
  fi
  if [ -n "$pinned" ] && [ -n "$current" ] && [ "$pinned" != "$current" ]; then
    echo "[WARN] El PDK descargado (${current:0:8}) NO es el fijado por el repo (${pinned:0:8})." >&2
    echo "       Desde PowerShell: git submodule update --init --recursive" >&2
  fi
  if [ ! -f "${pdk_path}/libs.tech/ngspice/osdi/psp103.osdi" ]; then
    echo "[WARN] Faltan los modelos OSDI compilados: ngspice no podrá simular transistores." >&2
    echo "       Ejecutá una vez: bash scripts/setup.sh" >&2
  fi

  echo "[OK] PDK ${PDK} fijado (commit ${short}) | PDK_ROOT=${PDK_ROOT}"
  return 0
}
if _sourceme_main "$@"; then
  unset -f _sourceme_main
else
  unset -f _sourceme_main
  return 1
fi

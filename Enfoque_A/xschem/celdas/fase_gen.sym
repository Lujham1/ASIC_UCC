v {xschem version=3.4.4 file_version=1.2
* Inversores de fase: vp1b = /vp1, vp2b = /vp2
}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
V {}
S {}
E {}
L 4 -100 -60 100 -60 {}

C {simulator_commands_shown.sym} -1800 400 2 1 {name=COMMANDS
simulator=ngspice
only_toplevel=false 
value=".lib cornerMOSlv.lib mos_tt
.lib cornerHBT.lib hbt_typ
.save all
.temp 25
.control
tran 100n 8m
*meas tran V3_AVG AVG v(3) FROM=6m TO=8m
*meas tran Vbe1 AVG V(Vbe1) FROM=6m TO=8m
*meas tran Vbe2 AVG V(Vbe2) FROM=6ms TO=8m
*meas tran V7_AVG AVG v(7) FROM=6m TO=8m
meas tran VREF_AVG AVG v(vref) FROM=6m TO=8m
*meas tran V4_AVG AVG v(4) FROM=7m TO=10m
*print V3_AVG
*print V4_AVG
*plot V(vp1) v(4)
*plot V(vp2) v(4)
*plot V(vp1) v(3) 
*plot V(vp2) v(3)
*plot v(2)-v(1) V(5)-v(6) v(7)-v(8) v(vp1)
*plot V(vp2) V(2)-V(1)
*plot V(vp2) V(5)-V(6)
*plot V(vp2) V(7)-V(8)
*plot V(vp2) V(vbe1) v(vbe2)
*plot V(vp2) V(vb1)-V(vbe2)
plot V(vp1) V(7)-V(1)
.endc
"}
